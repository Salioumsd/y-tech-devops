# ── Fichier .env — NE JAMAIS COMMITER CE FICHIER ──────────────────────────────
# Copiez ce fichier : cp .env.example .env
# Puis remplissez les valeurs

# ── Base de données ───────────────────────────────────────────────────────────
DB_ROOT_PASSWORD=ChangeMeRootPassword!
DB_NAME=ytech_db
DB_USER=ytech
DB_PASS=ChangeMeDbPassword!
DB_READONLY_PASS=ReadOnlyPass!

# ── Application Flask ─────────────────────────────────────────────────────────
# Générer avec : python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=changeme-generate-a-real-secret-key-here

# ── Compte administrateur initial ─────────────────────────────────────────────
ADMIN_PASSWORD=Admin1234!
